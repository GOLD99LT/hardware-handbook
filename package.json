{
  "name": "hardware-handbook-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "硬件学习生态 · pnpm Monorepo（P1 骨架）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "manifest": "pnpm -F @hw/content-core manifest",
    "manifest:parity": "pnpm -F @hw/content-core parity",
    "dev:template": "pnpm -F site-template dev",
    "build:template": "pnpm -F site-template build",
    "preview:template": "pnpm -F site-template preview",
    "verify": "echo \"(P1 占位) verify 统一编排将在 P2 接入 Python 质检与快照门禁\" && exit 0"
  }
}
